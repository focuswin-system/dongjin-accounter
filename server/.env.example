# 서버 환경변수 예시 — 실제 .env는 git에 포함하지 않는다(server/.env는 gitignore됨).
# 배포 서버에는 이미 생성되어 있음. 새 환경 구성 시 참고용.
DB_HOST=127.0.0.1
DB_USER=dongjin
DB_PASSWORD=__여기에_DB_비밀번호__
DB_NAME=dongjin_acct
PORT=8081
JWT_SECRET=__openssl_rand_-hex_32_로_생성__

# ── 멀티테넌트 (공용 관리 DB) ──
# 회사 레지스트리·로그인 계정·권한·감사로그가 사는 control-plane DB.
PLATFORM_DB_NAME=acct_platform
# 최초 1회: 기존 단일 테넌트(DB_NAME)를 첫 회사로 흡수할 때 부여할 회사코드.
# 소문자 영문·숫자·하이픈 4~20자. 로그인 화면에서 이 값을 입력한다.
BOOTSTRAP_COMPANY_CODE=dongjin
# company_info에 회사명이 없을 때만 사용하는 대체 회사명(선택).
# BOOTSTRAP_COMPANY_NAME=동진테크

# ── 권한 분리 (운영 필수) ──
# 위 DB_USER/DB_PASSWORD는 '앱 런타임' 계정이다 — DML만 갖고 DDL 권한은 없어야 한다.
# 스키마 생성·변경·신규 테넌트 DB 생성은 아래 관리 계정으로만 수행한다
# (npm run setup:db / provision-tenant). 웹 요청 경로가 탈취돼도 스키마를 못 건드리게 하는 장치.
# 미설정 시 앱 계정으로 폴백한다 — 로컬 개발에서만 허용.
DB_ADMIN_USER=acct_admin
DB_ADMIN_PASSWORD=__관리자_비밀번호__

# ── 첨부파일 접근 쿠키 ──
# HTTPS 배포에서는 반드시 1. 0이면 Secure 플래그 없이 발급되어 평문 구간에서 탈취될 수 있다.
# (이 쿠키에는 로그인 JWT가 담기므로 탈취되면 전 API에 사용 가능하다)
COOKIE_SECURE=1

# 권한 상태 확인:  npm run check:db   (부족한 GRANT 문을 그대로 출력해준다)
#
# 참고 — 필요한 권한 (root에서 1회):
#   CREATE USER 'acct_admin'@'localhost' IDENTIFIED BY '...';
#   GRANT ALL PRIVILEGES ON *.* TO 'acct_admin'@'localhost' WITH GRANT OPTION;
#   -- 앱 계정: DML만. GRANT에서 _ 는 와일드카드라 리터럴은 \_ 로 이스케이프한다.
#   GRANT SELECT, INSERT, UPDATE, DELETE ON `acct_platform`.* TO 'dongjin'@'localhost';
#   GRANT SELECT, INSERT, UPDATE, DELETE ON `acct\_%`.*        TO 'dongjin'@'localhost';
